generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String
  nom                String
  entreprise         String?
  telephone          String?
  adresse            String?
  codePostal         String?
  ville              String?
  siteWeb            String?
  googleAvisUrl      String?
  description        String?
  categories         String?
  communesDesservies String?
  type               AccountType
  createdAt          DateTime      @default(now())
  listings           Listing[]
  favorites          Favorite[]
  agencyReviews      Review[]      @relation("AgencyReviews")
  authoredReviews    Review[]      @relation("AuthoredReviews")
  savedSearches      SavedSearch[]
}

enum AccountType {
  PARTICULIER
  AGENCE
  ARTISAN
}

model Listing {
  id           String          @id @default(cuid())
  owner        User            @relation(fields: [ownerId], references: [id])
  ownerId      String
  transaction  TransactionType
  statut       ListingStatus   @default(EN_VERIFICATION)
  titre        String
  description  String
  prix         Int
  commune      String
  villageSlug  String
  pieces       Int
  chambres     Int
  surface      Int
  exterieur    String
  dpe          String?
  equipements  String          @default("")
  badge        String?
  photos       ListingPhoto[]
  priceHistory PriceHistory[]
  favorites    Favorite[]
  createdAt    DateTime        @default(now())

  @@index([ownerId])
  @@index([transaction, statut])
  @@index([villageSlug])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  url       String
  order     Int     @default(0)

  @@index([listingId])
}

/// Un enregistrement à chaque prix connu de l'annonce, y compris le prix
/// initial à sa création — permet de reconstituer l'historique complet.
model PriceHistory {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  prix      Int
  changedAt DateTime @default(now())

  @@index([listingId])
}

model Favorite {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId     String
  visite        Boolean  @default(false)
  surveillePrix Boolean  @default(false)
  contacte      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

/// Avis « Pévèle » : postés directement par les utilisateurs sur une agence,
/// publiés immédiatement (pas de back-office de modération pour l'instant).
model Review {
  id          String   @id @default(cuid())
  agency      User     @relation("AgencyReviews", fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId    String
  author      User     @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  note        Int
  commentaire String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencyId, authorId])
  @@index([agencyId])
}

/// Recherche enregistrée par un utilisateur (village + budget + type de
/// transaction) — consultée depuis /compte, pas de notification email pour
/// l'instant.
model SavedSearch {
  id          String          @id @default(cuid())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  transaction TransactionType
  q           String?
  budgetMax   Int?
  createdAt   DateTime        @default(now())

  @@index([userId])
}

enum TransactionType {
  VENTE
  LOCATION
}

enum ListingStatus {
  EN_VERIFICATION
  PUBLIEE
}

/// Transactions immobilières issues des DVF (Demandes de Valeurs Foncières,
/// data.gouv.fr / Etalab), filtrées aux communes de la Pévèle. Réimporté
/// périodiquement via `npm run dvf:import` — pas de saisie manuelle.
model DvfTransaction {
  id             String   @id @default(cuid())
  villageSlug    String
  dateMutation   DateTime
  typeLocal      String
  valeurFonciere Int
  surfaceBati    Int
  prixM2         Int
  nombrePieces   Int?
  adresse        String?
  sourceAnnee    Int

  @@index([villageSlug])
}
