generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  passwordHash        String
  nom                 String
  /// Prénom, requis à l'inscription depuis le 2026-09-17 — nullable en base
  /// pour ne pas casser les comptes créés avant (`nom` contenait alors un nom
  /// complet ou un prénom selon ce que la personne avait tapé, sans garantie).
  prenom              String?
  entreprise          String?
  telephone           String?
  adresse             String?
  codePostal          String?
  ville               String?
  siteWeb             String?
  googleAvisUrl       String?
  logoUrl             String?
  /// Mode de diffusion déclaré à l'inscription (agence uniquement) — MANUEL :
  /// saisie à la main depuis /vendre/deposer, comme un particulier.
  /// AUTOMATISE : l'agence a indiqué vouloir connecter son logiciel métier
  /// (voir logicielMetier). Ce n'est jamais un simple champ en libre-service :
  /// c'est ensuite Pévèle Immobilier qui contacte l'agence pour effectuer le
  /// branchement, et configure `xmlImportUrl` une fois cela fait — voir
  /// syncAgencyFeed() dans ac3-sync.ts, qui refuse toute synchro tant que
  /// l'agence n'est pas VERIFIEE. Null pour les comptes non-agence.
  modeAnnonces        AgencyListingMode?
  /// Nom du logiciel métier de diffusion (AC3, Immofacile, Netty...) déclaré
  /// à l'inscription si modeAnnonces = AUTOMATISE — texte libre, affiché en
  /// interne sur /admin/verifications pour que l'admin sache quoi demander
  /// en contactant l'agence.
  logicielMetier      String?
  xmlImportUrl        String?
  /// Horodatage de la dernière TENTATIVE de synchro (succès ou échec) —
  /// écrasé à chaque passage, y compris en échec (voir recordXmlSyncResult).
  /// Ne pas utiliser seul pour une affirmation de fraîcheur publique : un
  /// échec le met quand même à jour. Utiliser `xmlLastSuccessAt` pour ça.
  xmlLastSyncAt       DateTime?
  xmlLastSyncCount    Int?
  xmlLastSyncError    String?
  /// Horodatage de la dernière synchro RÉUSSIE uniquement — jamais écrasé par
  /// un échec, contrairement à `xmlLastSyncAt`. Source de vérité pour les
  /// affirmations de fraîcheur des annonces (voir src/lib/freshness.ts).
  xmlLastSuccessAt    DateTime?
  isAdmin             Boolean             @default(false)
  /// Vérification de l'agence (loi Hoguet) : SIRET + numéro de carte
  /// professionnelle (carte T) + CCI émettrice, validés à la main depuis le
  /// back-office. `siretDenomination` = raison sociale officielle récupérée en
  /// best-effort sur recherche-entreprises.api.gouv.fr à la soumission.
  siret               String?
  carteProfessionnelle String?
  carteProCci         String?
  /// Texte libre saisi à la demande de vérification (voir agency-verification.ts),
  /// affiché uniquement en interne sur /admin/verifications. Déprécié depuis le
  /// Sprint 5 pour tout usage public : remplacé par AgencyServiceArea, structuré
  /// et validé. Conservé tel quel pour compatibilité avec les demandes déjà
  /// soumises — jamais lu par une nouvelle fonctionnalité publique.
  zoneCouverte        String?
  siretDenomination   String?
  verifStatut         AgencyVerificationStatus @default(NON_SOUMISE)
  verifSoumiseLe      DateTime?
  verifTraiteeLe      DateTime?
  verifRaison         String?
  /// Jeton de réinitialisation de mot de passe (à usage unique, expire après 1h) — null hors demande en cours.
  resetToken          String?             @unique
  resetTokenExpiresAt DateTime?
  /// Date de vérification de l'adresse email (clic sur le lien reçu à l'inscription).
  /// Null tant que non vérifiée : certaines actions (déposer une annonce) l'exigent.
  /// `emailVerifyToken` : jeton à usage unique (32 octets aléatoires, non contraint
  /// `@unique` pour éviter une migration destructive sur SQLite — lookup par findFirst).
  emailVerifiedAt            DateTime?
  emailVerifyToken          String?
  emailVerifyTokenExpiresAt DateTime?
  /// Digest hebdomadaire du marché de la Pévèle : opt-in explicite depuis
  /// /compte. `lastDigestAt` = anti-doublon (un envoi au plus tous les 6 jours).
  digestOptIn        Boolean             @default(false)
  lastDigestAt       DateTime?
  description         String?
  categories          String?
  communesDesservies  String?
  type                AccountType
  createdAt           DateTime            @default(now())
  listings            Listing[]
  favorites           Favorite[]
  agencyReviews       Review[]            @relation("AgencyReviews")
  authoredReviews     Review[]            @relation("AuthoredReviews")
  savedSearches       SavedSearch[]
  devisRecus          DevisRequest[]      @relation("ArtisanDevis")
  devisEnvoyees       DevisRequest[]      @relation("AuthorDevis")
  clientMandates      SearchMandate[]     @relation("ClientMandates")
  agencyMandates      SearchMandate[]     @relation("AgencyMandates")
  visitRequests       VisitRequest[]
  estimationsRecues   EstimationRequest[] @relation("AgencyEstimations")
  estimationsEnvoyees EstimationRequest[] @relation("AuthorEstimations")
  openHouseRegistrations OpenHouseRegistration[]
  pushSubscriptions   PushSubscription[]
  serviceAreas        AgencyServiceArea[]

  @@index([emailVerifyToken])
}

enum AccountType {
  PARTICULIER
  AGENCE
  ARTISAN
}

enum AgencyVerificationStatus {
  NON_SOUMISE
  EN_ATTENTE
  VERIFIEE
  REFUSEE
}

enum AgencyListingMode {
  MANUEL
  AUTOMATISE
}

model Listing {
  id                 String            @id @default(cuid())
  owner              User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId            String
  transaction        TransactionType
  statut             ListingStatus     @default(EN_VERIFICATION)
  statutRaison       String?
  typeBien           TypeBien          @default(MAISON)
  /// Uniquement pour typeBien = MAISON : individuelle / semi-individuelle (mitoyenne d'un côté) / mitoyenne (des deux côtés).
  typeMaison         TypeMaison?
  titre              String
  description        String
  prix               Int
  commune            String
  villageSlug        String
  pieces             Int
  chambres           Int
  surface            Int
  exterieur          String
  /// Diagnostic de performance énergétique. `dpe` = classe énergie (A–G),
  /// `ges` = classe climat (A–G). `dpeConsommation` en kWh/m²/an (énergie
  /// primaire), `dpeEmissions` en kgCO₂/m²/an. `dpeCoutMin`/`dpeCoutMax` =
  /// fourchette du coût annuel d'énergie estimé (€), obligatoire sur une
  /// annonce depuis 2022 (loi Climat). Un logement F ou G est une « passoire
  /// thermique » à mentionner explicitement.
  dpe                String?
  ges                String?
  dpeConsommation    Int?
  dpeEmissions       Int?
  dpeCoutMin         Int?
  dpeCoutMax         Int?
  dpeCoutAnneeRef    Int?
  dpeDate            DateTime?
  /// Source d'énergie du chauffage (Gaz, Électrique, Fioul, Bois…) — champ
  /// texte libre plutôt qu'un enum fermé : les flux agence (AC3/Immofacile,
  /// balise MODE_CHAUFFAGE) renvoient des valeurs variées non exhaustives.
  modeChauffage      String?
  equipements        String            @default("")
  /// Frais & charges affichés sur la fiche.
  /// VENTE : `honoraires` (montant TTC, €) + `honorairesCharge`
  /// ("acquereur" | "vendeur") — l'affichage est obligatoire quand ils sont à
  /// la charge de l'acquéreur ; `chargesCopro` (€/mois pour un lot en
  /// copropriété) ; `taxeFonciere` (€/an).
  /// LOCATION : `chargesLoc` (provisions €/mois), `depotGarantie` (€), `meuble`.
  honoraires         Int?
  honorairesCharge   String?
  chargesCopro       Int?
  taxeFonciere       Int?
  chargesLoc         Int?
  depotGarantie      Int?
  meuble             Boolean?
  /// Caractéristiques détaillées du bien — toutes facultatives. Un champ non
  /// renseigné n'apparaît pas sur la fiche (la ligne est retirée, pas laissée
  /// vide). Champs à valeurs contraintes stockés en texte : `etat`
  /// (neuf|refait|bon|rafraichir|renover), `exposition`
  /// (nord|sud|est|ouest|nord-est|nord-ouest|sud-est|sud-ouest|traversant),
  /// `chauffageType` (individuel|collectif), `assainissement`
  /// (tout-a-l-egout|individuel). `etage` : 0 = rez-de-chaussée.
  anneeConstruction  Int?
  etat               String?
  exposition         String?
  surfaceTerrain     Int?
  etage              Int?
  ascenseur          Boolean?
  nbSallesDeBain     Int?
  stationnement      String?
  chauffageType      String?
  fibre              Boolean?
  assainissement     String?
  /// Modes de visite proposés sur la fiche. Choisis à la création de l'annonce,
  /// modifiables ensuite. Au moins l'un des deux est vrai.
  visitesIndividuelles Boolean         @default(true)
  visitesGroupees      Boolean         @default(false)
  badge              String?
  videoUrl           String?
  visiteVirtuelleUrl String?
  externalRef        String?
  importSource       String?
  photos             ListingPhoto[]
  priceHistory       PriceHistory[]
  lifecycleEvents    ListingLifecycleEvent[]
  favorites          Favorite[]
  proposals          ListingProposal[]
  visitRequests      VisitRequest[]
  openHouse          OpenHouse?
  createdAt          DateTime          @default(now())
  /// Date de passage à RETIREE (soft-delete) — null tant que l'annonce est active.
  retiredAt          DateTime?
  /// Dernière confirmation de présence dans le flux agence, mise à jour à
  /// chaque synchro XML où la référence est encore vue (création ou mise à
  /// jour). Reste tel quel pour une annonce déposée manuellement (pas de
  /// flux à reconfirmer) — pas un signal fiable dans ce cas, uniquement pour
  /// les annonces importées. `createdAt` sert déjà de date de première
  /// apparition fiable (jamais réécrit par upsertImportedListing) : pas de
  /// champ `firstSeenAt` séparé.
  lastSeenAt         DateTime?

  @@unique([ownerId, externalRef])
  @@index([ownerId])
  @@index([transaction, statut])
  @@index([villageSlug])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  url       String
  order     Int     @default(0)

  @@index([listingId])
}

/// Un enregistrement à chaque prix connu de l'annonce, y compris le prix
/// initial à sa création — permet de reconstituer l'historique complet.
model PriceHistory {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  prix      Int
  changedAt DateTime @default(now())

  @@index([listingId])
}

/// Instantané quotidien du marché des annonces actives, par commune et par
/// transaction — vente et location ne sont jamais mélangées (échelles de prix
/// incompatibles). Une ligne par commune × transaction × jour, y compris à 0
/// annonce, pour garder une série temporelle continue (un jour manquant serait
/// ambigu : panne du cron ou stock réellement nul ?). Alimenté par le cron
/// /api/cron/listing-snapshot (voir src/lib/listing-snapshot.ts). Fondation de
/// l'historisation du stock (Sprint 3) — aucune exploitation publique tant
/// qu'on n'a pas plusieurs mois de recul. Donnée BRUTE : jamais réécrite
/// rétroactivement une fois le jour passé (seul le jour courant est
/// ré-upserté par un second passage du cron le même jour). Une future
/// métrique dédupliquée (multi-agences) vivra dans un modèle séparé,
/// référençant la même clé (villageSlug, transaction, date) — jamais en
/// remplaçant ces colonnes.
model ListingSnapshot {
  id                String          @id @default(cuid())
  villageSlug       String
  transaction       TransactionType
  date              DateTime        @db.Date
  totalCount        Int
  maisonCount       Int
  appartementCount  Int
  terrainCount      Int
  /// Moyenne/médiane/prix au m²/surface : null quand totalCount = 0 (rien à moyenner).
  avgPrix           Int?
  medianPrix        Int?
  avgPrixM2         Int?
  surfaceMoyenne    Int?
  /// Annonces dont `createdAt` tombe dans les 24h précédant le snapshot.
  nouvellesAnnonces Int
  /// Nombre d'agences distinctes (User.type = AGENCE) ayant au moins une
  /// annonce active dans cette commune/transaction ce jour-là — jamais
  /// calculé sur un simple ownerId, qui peut aussi être un particulier.
  /// Vaut 0 quand totalCount = 0. Champ interne : sans valeur d'affichage
  /// tant qu'une seule agence est active sur le portail (voir /methodologie).
  agencyCount       Int             @default(0)
  createdAt         DateTime        @default(now())

  @@unique([villageSlug, transaction, date])
  @@index([villageSlug])
}

enum SnapshotSourceType {
  AGENCY
  DIRECT
}

/// Répartition, par source, du stock compté dans ListingSnapshot le même
/// jour — une ligne par commune × transaction × jour × source. AGENCY a un
/// sourceId = User.id de l'agence ; DIRECT agrège TOUS les dépôts non-agence
/// (particuliers, artisans) sous un sourceId constant ("direct") plutôt
/// qu'un identifiant par personne, pour ne jamais exposer de volumétrie
/// individuelle. `sourceFreshAt` reprend `User.xmlLastSuccessAt` de l'agence
/// au moment du calcul (null pour DIRECT, pas de notion de synchro) — permet
/// de savoir plus tard qu'un snapshot calculé un jour donné agrège des
/// sources dont la fraîcheur réelle diffère, sans bloquer le calcul.
/// Donnée BRUTE au même titre que ListingSnapshot : jamais réécrite
/// rétroactivement.
model ListingSnapshotSource {
  id            String             @id @default(cuid())
  villageSlug   String
  transaction   TransactionType
  date          DateTime           @db.Date
  sourceType    SnapshotSourceType
  sourceId      String
  count         Int
  sourceFreshAt DateTime?
  createdAt     DateTime           @default(now())

  @@unique([villageSlug, transaction, date, sourceType, sourceId])
  @@index([villageSlug])
}

enum ListingLifecycleEventType {
  RETIRED
  REPUBLISHED
}

/// Historique événementiel du cycle de vie d'une annonce — complète
/// `Listing.statut`/`retiredAt` (qui ne donnent que l'état COURANT) pour
/// pouvoir reconstruire les épisodes successifs d'exposition (publication →
/// retrait → republication → retrait...). Pas d'événement CREATED : la
/// première apparition est déjà capturée de façon fiable par
/// `Listing.createdAt` (jamais réécrit), un événement dupliquerait cette
/// donnée sans rien apporter. RETIRED est émis par
/// `retireStaleImportedListings`, REPUBLISHED par `upsertImportedListing`
/// quand une annonce RETIREE réapparaît dans le flux. Jamais réécrit ni
/// supprimé une fois créé — voir /methodologie, « durée d'exposition
/// observée ».
model ListingLifecycleEvent {
  id        String                    @id @default(cuid())
  listing   Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  type      ListingLifecycleEventType
  createdAt DateTime                  @default(now())

  @@index([listingId])
}

/// Zone d'intervention déclarée par une agence (Sprint 5) — une ligne par
/// commune cochée dans son profil, remplace le texte libre zoneCouverte pour
/// tout usage public. Table normalisée plutôt qu'un CSV (comme
/// communesDesservies côté artisans) : jointure directe, contrainte
/// d'unicité, comptage par commune possibles. villageSlug n'est pas une
/// clé étrangère vers un modèle Village (les communes suivies vivent dans
/// src/data/villages.ts, pas en base) — toujours validé applicativement
/// contre cette liste avant écriture, jamais fait confiance côté client.
model AgencyServiceArea {
  id          String @id @default(cuid())
  agency      User   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId    String
  villageSlug String

  @@unique([agencyId, villageSlug])
  @@index([villageSlug])
}

/// Horodatage du dernier passage réussi de chaque tâche cron — source unique
/// et fiable pour les mentions de fraîcheur affichées publiquement (ex.
/// « DVF actualisé le... »), plutôt que de deviner à partir d'une donnée
/// métier annexe. Une ligne par job, réécrite à chaque exécution réussie.
model CronRun {
  job   String   @id
  ranAt DateTime @default(now())
  meta  String?
}

model Favorite {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId     String
  visite        Boolean  @default(false)
  surveillePrix Boolean  @default(false)
  contacte      Boolean  @default(false)
  createdAt     DateTime @default(now())
  /// Prix de référence pour l'alerte « baisse de prix » : initialisé par le
  /// cron /api/cron/alerts au prix courant, puis abaissé à chaque notification.
  /// Le cron notifie quand le prix de l'annonce passe sous cette valeur.
  lastNotifiedPrix Int?

  @@unique([userId, listingId])
  @@index([listingId])
}

/// Avis « Pévèle » : postés directement par les utilisateurs sur une agence,
/// publiés immédiatement (pas de back-office de modération pour l'instant).
model Review {
  id          String   @id @default(cuid())
  agency      User     @relation("AgencyReviews", fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId    String
  author      User     @relation("AuthoredReviews", fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String
  note        Int
  commentaire String
  /// Avis posté par un administrateur depuis le back-office, affiché comme
  /// un avis officiel « Pévèle Immobilier » plutôt qu'au nom de l'auteur.
  isOfficial  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agencyId, authorId])
  @@index([agencyId])
}

/// Recherche enregistrée par un utilisateur (village + budget + type de
/// transaction) — consultée depuis /compte, et notifiée par email des
/// nouveaux biens correspondants via le cron /api/cron/alerts.
model SavedSearch {
  id           String          @id @default(cuid())
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  transaction  TransactionType
  typeBien     TypeBien?
  typeMaison   TypeMaison?
  q            String?
  villageSlugs String?
  chambresMin  Int?
  equipements  String?
  budgetMin    Int?
  budgetMax    Int?
  createdAt    DateTime        @default(now())
  /// Date du dernier email d'alerte envoyé. Null tant qu'aucune alerte n'a été
  /// émise : la fenêtre des « nouveaux biens » part alors de `createdAt`.
  lastAlertedAt DateTime?
  mandates     SearchMandate[]

  @@index([userId])
}

/// Mandat de recherche : un particulier confie une recherche sauvegardée à
/// une agence, qui l'accepte ou la refuse. Une fois acceptée, le particulier
/// devient un client visible dans le hub de l'agence.
model SearchMandate {
  id            String            @id @default(cuid())
  savedSearch   SavedSearch       @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  savedSearchId String
  client        User              @relation("ClientMandates", fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  agency        User              @relation("AgencyMandates", fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId      String
  statut        MandateStatus     @default(EN_ATTENTE)
  createdAt     DateTime          @default(now())
  respondedAt   DateTime?
  proposals     ListingProposal[]

  @@unique([savedSearchId, agencyId])
  @@index([agencyId])
  @@index([clientId])
}

enum MandateStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

/// Bien proposé par une agence à un client pour répondre à une recherche
/// confiée et acceptée — visible côté agence (fiche client) et côté
/// particulier (sous sa recherche sauvegardée).
model ListingProposal {
  id        String         @id @default(cuid())
  mandate   SearchMandate  @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  mandateId String
  listing   Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  statut    ProposalStatus @default(PROPOSEE)
  createdAt DateTime       @default(now())

  @@unique([mandateId, listingId])
  @@index([mandateId])
  @@index([listingId])
}

enum ProposalStatus {
  PROPOSEE
  INTERESSE
  PAS_INTERESSE
}

/// Demande de devis envoyée par un utilisateur à un artisan depuis sa fiche
/// publique — pas de notification email pour l'instant, consultée depuis
/// /compte côté artisan.
model DevisRequest {
  id        String   @id @default(cuid())
  artisan   User     @relation("ArtisanDevis", fields: [artisanId], references: [id], onDelete: Cascade)
  artisanId String
  author    User     @relation("AuthorDevis", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  message   String
  telephone String?
  traite    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([artisanId])
}

/// Demande de visite envoyée par un utilisateur sur une annonce — pas de
/// notification email pour l'instant, consultée depuis /compte côté
/// propriétaire de l'annonce.
model VisitRequest {
  id            String    @id @default(cuid())
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId     String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  message       String
  telephone     String?
  preferredDate DateTime?
  traite        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([listingId])
  @@index([authorId])
}

/// Demande de rendez-vous d'estimation envoyée à une agence depuis sa fiche
/// publique — l'agence accepte ou refuse (comme un SearchMandate), pas de
/// notification email pour l'instant. Consultée depuis /compte des deux côtés
/// : l'agence qui reçoit, l'auteur qui suit sa demande.
model EstimationRequest {
  id            String        @id @default(cuid())
  agency        User          @relation("AgencyEstimations", fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId      String
  author        User          @relation("AuthorEstimations", fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  adresse       String
  nom           String
  telephone     String
  preferredDate DateTime?
  statut        MandateStatus @default(EN_ATTENTE)
  respondedAt   DateTime?
  createdAt     DateTime      @default(now())

  @@index([agencyId])
  @@index([authorId])
}

/// Évènement « portes ouvertes » (visite groupée à l'américaine) créé par le
/// propriétaire d'une annonce — particulier ou agence. Un seul évènement par
/// annonce ; il regroupe une ou plusieurs dates (OpenHouseDate). Présenté sur
/// la fiche du bien avec un bouton « S'inscrire ».
model OpenHouse {
  id        String          @id @default(cuid())
  listing   Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String          @unique
  /// Consignes générales affichées aux inscrits (accès, documents à apporter…).
  note      String?
  annulee   Boolean         @default(false)
  createdAt DateTime        @default(now())
  dates     OpenHouseDate[]
}

/// Un créneau daté d'un évènement portes ouvertes. `capacity` = nombre maximum
/// d'inscriptions acceptées ; au-delà le créneau est complet.
model OpenHouseDate {
  id            String                  @id @default(cuid())
  openHouse     OpenHouse               @relation(fields: [openHouseId], references: [id], onDelete: Cascade)
  openHouseId   String
  startAt       DateTime
  endAt         DateTime
  capacity      Int
  registrations OpenHouseRegistration[]

  @@index([openHouseId])
}

/// Inscription d'un visiteur (connecté) à un créneau de portes ouvertes. Le
/// propriétaire accepte ou refuse (statut EN_ATTENTE → ACCEPTEE / REFUSEE,
/// même enum que les mandats). Un visiteur ne peut s'inscrire qu'une fois par
/// créneau.
model OpenHouseRegistration {
  id          String        @id @default(cuid())
  date        OpenHouseDate @relation(fields: [dateId], references: [id], onDelete: Cascade)
  dateId      String
  visiteur    User          @relation(fields: [visiteurId], references: [id], onDelete: Cascade)
  visiteurId  String
  nom         String
  prenom      String
  telephone   String
  statut      MandateStatus @default(EN_ATTENTE)
  respondedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([dateId, visiteurId])
  @@index([dateId])
  @@index([visiteurId])
}

/// Lead capté sur l'estimation en ligne (`/estimer`) : le visiteur a demandé
/// à recevoir sa fourchette + un suivi du marché. Pas de compte requis. À
/// traiter à la main / router vers une agence (`traite`). L'estimation
/// (`estimLow`/`estimHigh`) est figée telle qu'affichée au moment de la
/// capture.
model EstimationLead {
  id          String   @id @default(cuid())
  villageSlug String
  commune     String
  surface     Int
  typeBien    String
  dpe         String?
  estimLow    Int
  estimHigh   Int
  nom         String
  email       String
  telephone   String?
  traite      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

enum TransactionType {
  VENTE
  LOCATION
}

enum ListingStatus {
  EN_VERIFICATION
  PUBLIEE
  REFUSEE
  /// Disparue du flux agence (vendue ou retirée côté CRM — on ne sait pas
  /// laquelle des deux sans information explicite, donc on ne le déduit
  /// jamais) — anciennement supprimée définitivement, désormais conservée en
  /// soft-delete pour ne pas perdre PriceHistory ni les statistiques
  /// d'historisation. Exclue de toutes les vues publiques et du sitemap
  /// (tous les filtres existants ciblent explicitement `PUBLIEE`).
  RETIREE
}

enum TypeBien {
  MAISON
  APPARTEMENT
  TERRAIN
}

/// Mitoyenneté d'une maison — champ retrouvé dans les flux agence (AC3 /
/// Immofacile, balise MITOYENNETE : "Indépendant" / "1 côté" / "2 côtés").
enum TypeMaison {
  INDIVIDUELLE
  SEMI_INDIVIDUELLE
  MITOYENNE
}

/// Évènement produit (entonnoir) — écrit en « fire and forget » depuis les
/// Server Actions (et quelques pages serveur) via `src/lib/events.ts`. Sert
/// au tableau de bord `/admin/stats`. Volontairement minimal et sans PII :
/// Tentatives de connexion échouées, pour un blocage temporaire par email
/// (bourrage d'identifiants) — remplace Turnstile sur /connexion, retiré car
/// il gênait les connexions légitimes sans protéger contre autre chose que
/// les bots (voir src/lib/login-throttle.ts). Pas de FK vers User : on
/// enregistre aussi les tentatives sur des emails inconnus (sinon un
/// attaquant pourrait déduire qu'un compte existe en constatant l'absence de
/// blocage). Les lignes expirées d'un email sont purgées à chaque vérification
/// (isLoginThrottled) — pas de job de nettoyage séparé nécessaire.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// `userId` est libre (pas de FK — on garde l'historique même après
/// suppression du compte), `meta` = petit JSON optionnel (< 2 ko).
model Event {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  path      String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

/// Abonnement push (Web Push / VAPID) d'un appareil pour un compte. Un même
/// utilisateur peut avoir plusieurs abonnements (plusieurs appareils/navigateurs) ;
/// `endpoint` identifie l'appareil (unique par service de push du navigateur).
/// `p256dh`/`auth` sont les clés de chiffrement fournies par le navigateur à la
/// souscription. Purgé automatiquement par sendPushNotification (src/lib/push.ts)
/// quand le navigateur répond 404/410 (abonnement expiré ou révoqué).
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Transactions immobilières issues des DVF (Demandes de Valeurs Foncières,
/// data.gouv.fr / Etalab), filtrées aux communes de la Pévèle. Réimporté
/// périodiquement via `npm run dvf:import` — pas de saisie manuelle.
model DvfTransaction {
  id             String   @id @default(cuid())
  villageSlug    String
  dateMutation   DateTime
  typeLocal      String
  valeurFonciere Int
  surfaceBati    Int
  prixM2         Int
  nombrePieces   Int?
  adresse        String?
  sourceAnnee    Int
  /// Surface du terrain (m²), balise `surface_terrain` du CSV DVF source —
  /// non retenue à l'import avant le 2026-09-21. Présente sur ~98% des
  /// ventes de maisons en Pévèle (vérifié en direct sur le fichier réel),
  /// absente sur beaucoup d'appartements (pas de terrain propre) — nullable,
  /// jamais utilisée pour exclure une transaction.
  surfaceTerrain Int?
  /// Coordonnées de la mutation, balises `latitude`/`longitude` du CSV DVF
  /// source — même origine que surfaceTerrain, capturées mais pas encore
  /// exploitées par une page (aucune carte DVF à ce jour).
  latitude       Float?
  longitude      Float?

  @@index([villageSlug])
}
