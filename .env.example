# Stockage objet Cloudflare R2 (photos d'annonces, logos) — dash.cloudflare.com
# -> R2 Object Storage. R2_ACCOUNT_ID : visible sur la page d'accueil R2.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY : "Manage API Tokens" -> Create API
# Token (permissions Object Read & Write, scopées au bucket). R2_PUBLIC_URL :
# URL publique du bucket (Settings -> Public Access -> R2.dev subdomain, ou un
# domaine personnalisé), sans slash final.
R2_ACCOUNT_ID="0000000000000000000000000000"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET="pevele-immobilier"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# Suivi d'erreurs Sentry (optionnel — vide = désactivé, aucun envoi).
# Poste directement l'enveloppe d'ingestion, sans SDK (src/lib/report-error.ts).
# SENTRY_DSN : erreurs serveur (instrumentation.ts). NEXT_PUBLIC_SENTRY_DSN :
# erreurs client (instrumentation-client.ts + global-error.tsx) — souvent la même valeur.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
